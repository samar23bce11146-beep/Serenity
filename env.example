const express      = require('express');
const router       = express.Router();
const NotifySignup = require('../models/NotifySignup');

/*
  POST /api/notify
  ─────────────────────────────────────────────────────────────
  Called when a user submits a "Notify Me" form in any of the
  placeholder sections (Light Therapy, Sound Therapy, Breathing,
  Quick Calm).

  The updated frontend has these forms in each section:
    <form class="notify-form" onsubmit="event.preventDefault();">
      <input type="email" placeholder="Your email address" />
      <button type="submit">Notify Me</button>
    </form>

  Frontend sends:
    { email: "user@example.com", section: "light-therapy" }

  Backend responds:
    { message: "You're on the list!", section: "light-therapy" }
*/
router.post('/', async (req, res) => {
  try {
    const { email, section } = req.body;

    const validSections = ['light-therapy', 'sound-therapy', 'breathing', 'quick-calm'];

    if (!email) return res.status(400).json({ error: 'Email is required.' });
    if (!section || !validSections.includes(section)) {
      return res.status(400).json({ error: `Invalid section. Must be one of: ${validSections.join(', ')}` });
    }

    // Check for duplicate — same email already signed up for this section
    const existing = await NotifySignup.findOne({ email, section });
    if (existing) {
      return res.status(200).json({
        message: "You're already on the list for this feature!",
        section,
        alreadySignedUp: true
      });
    }

    const signup = new NotifySignup({ email, section });
    await signup.save();

    res.status(201).json({
      message: "You're on the list! We'll notify you when this launches.",
      section,
      alreadySignedUp: false
    });

  } catch (err) {
    // Handle mongoose duplicate key error gracefully
    if (err.code === 11000) {
      return res.status(200).json({
        message: "You're already on the list for this feature!",
        alreadySignedUp: true
      });
    }
    console.error('Error saving notify signup:', err);
    res.status(500).json({ error: 'Server error. Please try again.' });
  }
});

/*
  GET /api/notify
  Returns all notify signups. Filter by ?section=light-therapy
*/
router.get('/', async (req, res) => {
  try {
    const filter = req.query.section ? { section: req.query.section } : {};
    const signups = await NotifySignup.find(filter).sort({ createdAt: -1 });
    res.json({ count: signups.length, signups });
  } catch (err) {
    res.status(500).json({ error: 'Server error.' });
  }
});

module.exports = router;
